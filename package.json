{
  "name": "audio-bench-monorepo",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "desktop:dev": "bun --filter desktop dev",
    "desktop:build": "bun --filter desktop build",
    "tauri": "bun --filter backend tauri"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "lefthook": "^2.2.2",
    "turbo": "^2.4.4"
  }
}
