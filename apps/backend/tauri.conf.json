{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Bench",
  "version": "0.1.0",
  "identifier": "com.karumelabs.AudioBench",
  "build": {
    "beforeDevCommand": "bun --filter desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun --filter desktop build",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audio Bench",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}